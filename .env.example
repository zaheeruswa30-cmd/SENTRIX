# ════════════════════════════════════════════════════════════════════════
#  Sentrix — environment configuration
#  Copy to .env (git-ignored) and adjust. Never commit real secrets.
#  Variable names are unchanged from SecureWatch AI, so older .env files keep working.
# ════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────
APP_NAME=Sentrix
# development | staging | production | test
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:8000
# Base URL users reach the app on — used to build ownership-verification links
PUBLIC_BASE_URL=http://localhost:8000
# Serve the web app (ui-prototype/) at "/" from the API process
SERVE_FRONTEND=true

# ── Security ──────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Also keys the HMAC used to hash verification tokens — changing it invalidates pending challenges.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=12
ALLOW_SELF_REGISTRATION=true

# ── Database ──────────────────────────────────────────────────────────
# Default (leave commented): SQLite file sentrix.db in the repository root.
# DATABASE_URL=postgresql+psycopg://securewatch:securewatch@localhost:5432/securewatch
# Dev convenience: create tables on startup. Use Alembic and set false in staging/production.
AUTO_CREATE_SCHEMA=true

# ── DNS ───────────────────────────────────────────────────────────────
DNS_TIMEOUT_SECONDS=4.0
# system | doh
DNS_RESOLVER=system
DNS_DOH_URL=https://cloudflare-dns.com/dns-query
# If the system resolver is blocked, retry over DNS-over-HTTPS
DNS_DOH_FALLBACK=true
# Domain analysis cache lifetime
DOMAIN_CACHE_HOURS=6
DKIM_COMMON_SELECTORS=default,selector1,selector2,google,k1,k2,s1,s2,dkim,mail,smtp,mx,everlytickey1,mandrill,zoho,protonmail,protonmail2,protonmail3,fm1,fm2,fm3

# ── Optional enrichment (off by default; enable only where usage terms allow) ──
ENRICHMENT_RDAP_ENABLED=false
RDAP_BASE_URL=https://rdap.org/domain/
ENRICHMENT_DNSBL_ENABLED=false
DNSBL_DOMAIN_ZONES=dbl.spamhaus.org
# Domains checked for look-alike / impersonation (comma-separated)
PROTECTED_BRAND_DOMAINS=paypal.com,microsoft.com,google.com,apple.com,amazon.com,facebook.com,linkedin.com,office365.com,outlook.com,dropbox.com,docusign.com,netflix.com

# ── Email delivery (ownership verification + notifications) ──────────
# dev_outbox (writes .eml files to outbox/, nothing is sent) | smtp | sendgrid | disabled
EMAIL_PROVIDER=dev_outbox
EMAIL_FROM_ADDRESS=no-reply@sentrix.local
EMAIL_FROM_NAME=Sentrix Identity Intelligence
# SMTP (docker compose up -d mailpit → localhost:1025, web UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# SendGrid
SENDGRID_API_KEY=

# ── Ownership verification ────────────────────────────────────────────
OWNERSHIP_TOKEN_TTL_MINUTES=15
OWNERSHIP_MAX_ATTEMPTS=5
OWNERSHIP_MAX_SENDS_PER_DAY=5
OWNERSHIP_RESEND_COOLDOWN_SECONDS=60

# ── Rate limits ───────────────────────────────────────────────────────
EMAIL_CHECKS_PER_HOUR=120

# ── LLM (optional — Sentrix AI works deterministically without one) ──
# none | ollama | openai
LLM_PROVIDER=none
LLM_REPORT_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# ── Incidents / reports ───────────────────────────────────────────────
# Optional: notify this address when an email-identity incident is opened
INCIDENT_NOTIFY_EMAIL=
# Default: reports/ in the repository root
# REPORTS_DIR=./reports

# ── Demo ──────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
