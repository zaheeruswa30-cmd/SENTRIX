# ── App ───────────────────────────────────────────────────────────────
APP_NAME=SecureWatch AI
ENVIRONMENT=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# ── Security (NEVER commit real values) ───────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_MFA_FOR_ADMIN=true
PASSWORD_MIN_LENGTH=12

# ── Databases ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://securewatch:securewatch@localhost:5432/securewatch
# local dev alternative: sqlite+pysqlite:///./securewatch.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_KB_COLLECTION=kb_chunks
QDRANT_EVENT_COLLECTION=event_vectors

# ── Embeddings / RAG ──────────────────────────────────────────────────
EMBEDDING_PROVIDER=local                  # local | openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=25
RERANK_TOP_N=5
RETRIEVAL_SCORE_FLOOR=0.35
MAX_CHUNKS_PER_DOC=2

# ── LLM ───────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama                       # ollama | openai | anthropic
LLM_TRIAGE_MODEL=llama3.1:8b
LLM_REPORT_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1500
LLM_DAILY_TOKEN_BUDGET=2000000

# ── Uploads ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads                      # outside the web root
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=800
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,md,docx
CLAMAV_ENABLED=false

# ── Monitoring / agents ───────────────────────────────────────────────
AGENT_TOKEN_TTL_DAYS=365
HEARTBEAT_INTERVAL_SECONDS=60
DEGRADED_AFTER_MISSED_HEARTBEATS=2
OFFLINE_AFTER_MISSED_HEARTBEATS=5
INGEST_MAX_BATCH=200
ANALYSIS_SEVERITY_THRESHOLD=medium        # events at/above this get AI analysis

# ── Retention ─────────────────────────────────────────────────────────
EVENT_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1095

# ── Demo ──────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
DEMO_DATA_BANNER=true
