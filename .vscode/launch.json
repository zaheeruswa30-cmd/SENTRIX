{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sentrix API (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Sentrix: seed demo data",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.seed_demo",
      "args": ["--with-checks"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Sentrix: pytest (all)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-vv"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Sentrix: pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-vv"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
