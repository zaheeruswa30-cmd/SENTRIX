{
  "version": "2.0.0",
  "tasks": [
    { "label": "infra: up",        "type": "shell", "command": "docker compose up -d postgres redis qdrant" },
    { "label": "db: migrate",      "type": "shell", "command": "alembic -c backend/alembic.ini upgrade head" },
    { "label": "db: seed demo",    "type": "shell", "command": "python -m scripts.seed_demo" },
    { "label": "api: run",         "type": "shell", "command": "uvicorn backend.app.main:app --reload --port 8000" },
    { "label": "ui prototype: serve", "type": "shell", "command": "python -m http.server 5500 --directory ui-prototype" },
    { "label": "frontend: dev",    "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/frontend" } },
    { "label": "qa: all",          "type": "shell", "command": "ruff check . && mypy backend/app && pytest -q && bandit -q -r backend/app" }
  ]
}
