# ==========================================
# SENTRIX 2.0 - Git Ignore Configuration
# ==========================================

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local databases and data
*.db
*.sqlite3
sentrix.db

# Outbox
outbox/*
!outbox/.gitkeep

# Reports
reports/*
!reports/.gitkeep

# Uploads
uploads/*
!uploads/.gitkeep

# Knowledge base
knowledge_base/*
!knowledge_base/.gitkeep

# Frontend
node_modules/
frontend/dist/

# Models and generated files
models_cache/
shots/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Vercel
.vercel/